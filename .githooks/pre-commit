#!/bin/sh
# config.yaml の整合性をコミット前に確認する。
#   有効にする: git config core.hooksPath .githooks
#   一時的に飛ばす: git commit --no-verify
git diff --cached --name-only --diff-filter=ACM | grep -qx 'config.yaml' || exit 0

root=$(git rev-parse --show-toplevel)
py="$root/.venv/bin/python"
[ -x "$py" ] || py=$(command -v python3 || command -v python)
if [ -z "$py" ] || ! "$py" -c "import ruamel.yaml" 2>/dev/null; then
  echo "pre-commit: Python または依存ライブラリが見つかりません（pip install -r requirements.txt）" >&2
  exit 1
fi

# 作業ツリーではなく、コミットされる内容（ステージ済み）を確認する
tmp=$(mktemp "${TMPDIR:-/tmp}/config.XXXXXX.yaml")
trap 'rm -f "$tmp"' EXIT
git show :config.yaml > "$tmp"
cd "$root" && "$py" -m ytpl.check "$tmp" --label "config.yaml（ステージ済み）" || {
  printf '\nconfig.yaml にエラーがあるためコミットを中止しました（無視する場合は git commit --no-verify）。\n' >&2
  exit 1
}
